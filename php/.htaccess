# Disable directory listing
Options -Indexes

# Protect configuration, dotfiles, internal state, rate-limiter, member lists, lock handlers, and temporary files from direct web access
<FilesMatch "^(\..*|config\.php|lock_handler\.php|lock_rotation\.php|ratelimit\.bin\.php|members\..*\.php|.*\.tmp.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Clean URL aliases for /sync and /anchors/<anchor_id>.bin
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^sync$ sync.php [QSA,L]
    RewriteRule ^anchors/([0-9a-f]{64}\.bin)$ sync.php?__anchor=$1 [QSA,L]
</IfModule>
